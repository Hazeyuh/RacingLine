     } 
 
+    if (database.has_element(path+"rental-gear-ratio")) {
+        _rental_curve = true;
+        auto read = [&](const std::string& key) {
+            auto element = database.get_element(path+key);
+            const auto value = element.get_value(double());
+            element.set_attribute("__unused__", "false");
+            return value;
+        };
+        _gear_ratio = read("rental-gear-ratio");
+        _efficiency = read("rental-efficiency");
