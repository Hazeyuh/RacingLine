@@ -37,6 +54,30 @@ inline Timeseries_t Engine<Timeseries_t>::operator()(const Timeseries_t throttle
     if ( _direct_torque )
         return throttle_percentage;
 
+    else if (_rental_curve) {
+        // Smooth phenomenological four-stroke torque curve and clutch slip.
+        // Retain AD dependence on axle speed throughout the optimization.
+        const Timeseries_t sync = angular_speed*_gear_ratio/RPM;
+        const Timeseries_t diff = sync-_clutch_rpm;
+        _engine_rpm = 0.5*(sync+_clutch_rpm+sqrt(diff*diff+100.0*100.0));
+        // Smoothly hold the official curve endpoints outside 2000--3600 rpm.
+        const Timeseries_t low = _engine_rpm-2000.0;
+        const Timeseries_t above_low = 2000.0+0.5*(low+sqrt(low*low+100.0));
+        const Timeseries_t high = above_low-3600.0;
+        const Timeseries_t curve_rpm = 3600.0+0.5*(high-sqrt(high*high+100.0));
+        const Timeseries_t x = (curve_rpm-2800.0)/800.0;
+        Timeseries_t torque = 0.0;
+        for (auto it=_torque_coefficients.rbegin(); it!=_torque_coefficients.rend(); ++it) torque = torque*x+*it;
+        torque *= _maximum_power/_reference_power;
+        const Timeseries_t z = (_engine_rpm-_limit_rpm)/100.0;
+        const Timeseries_t governor = 0.5*(1.0-z/sqrt(1.0+z*z));
+        const Timeseries_t c = diff/200.0;
+        const Timeseries_t coupling = 0.35+0.65*0.5*(1.0+c/sqrt(1.0+c*c));
+        const Timeseries_t shaft_torque = throttle_percentage*torque*governor*coupling*_gear_ratio*_efficiency;
+        _power = shaft_torque*angular_speed;
+        _engine_power = throttle_percentage*torque*governor*coupling*_engine_rpm*RPM;
+        return shaft_torque;
+    }
     else if ( _only_max_power )
     {
         _power = throttle_percentage*(_maximum_power*1.0e3);
