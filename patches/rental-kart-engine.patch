+        _clutch_rpm = read("rental-clutch-rpm");
+        _reference_power = read("rental-reference-power");
+        auto coefficients = database.get_element(path+"rental-torque-coefficients");
+        _torque_coefficients = coefficients.get_value(std::vector<double>());
